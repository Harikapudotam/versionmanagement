{
  "_version": "1.85.0",
  "sap.app": {
    "id": "ust.access.access",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.27.0",
      "toolsId": "8a2357f0-9ba4-4a1a-afa6-718334869ff6"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v2/my/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.149.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ust.access.access.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "ust.access.access.view",
        "async": true,
        "viewPath": "ust.access.access.view"
      },
      "routes": [
        {
          "name": "Routeuseraccess",
          "pattern": ":?query:",
          "target": [
            "Targetuseraccess"
          ]
        },
        {
          "name": "create",
          "pattern": "create",
          "target": [
            "Targetcreate"
          ]
        }
      ],
      "targets": {
        "Targetuseraccess": {
          "id": "useraccess",
          "name": "useraccess"
        },
        "Targetcreate": {
          "id": "create",
          "name": "create"
        }
      }
    },
    "rootView": {
      "viewName": "ust.access.access.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ust.salesorder"
  }
}
